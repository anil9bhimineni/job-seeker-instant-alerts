    "jsCode": "// ===== SETTINGS: edit these =====\nconst TELEGRAM_TOKEN = 'PASTE_BOT_TOKEN';   // from @BotFather\nconst TELEGRAM_CHAT_ID = 'PASTE_CHAT_ID';   // your chat id (message @userinfobot)\n// Roles you want. A job matches if its TITLE or its JOB DESCRIPTION names one of these roles.\nconst ROLES = /\\b((senior|sr\\.?|associate|lead|principal|group|staff)\\s+)?((ai|genai|data|technical|platform|digital)\\s+)?product (manager|owner)\\b|\\bproduct management\\b|\\bdirector,?\\s+(of\\s+)?product\\b|\\bhead of product\\b|\\bbusiness analyst\\b|\\bsystems? analyst\\b|\\banalytic(s|al)? manager\\b|\\b(ai|data|digital)\\s+delivery\\b|\\bdelivery (manager|lead|head)\\b|\\bsenior manager\\b.{0,30}\\b(ai|delivery|product)\\b/i;\n// Titles that are never what you want, even if the description mentions a role above.\nconst EXCLUDE = /\\bintern\\b|\\bengineer\\b|\\bdeveloper\\b|\\bsales\\b|account (executive|manager)|\\bmarketing\\b|recruit|\\bdesigner\\b|\\bscientist\\b|accountant|\\bnurse\\b|technician|warehouse|\\bdriver\\b|customer (support|service)|\\bfinance\\b|\\bhr\\b|legal counsel/i;\nconst WORKDAY_SEARCHES = ['product manager', 'product management', 'business analyst', 'systems analyst', 'delivery AI'];\nconst strip = (h) => String(h || '').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/<[^>]+>/g, ' ').replace(/&nbsp;|&#\\d+;/g, ' ').replace(/\\s+/g, ' ');\nconst LOC = /india|bengaluru|bangalore|remote|hyderabad|pune/i;\nconst DETECT_PER_RUN = 20; // companies auto-detected per run (first few runs only)\n\n// Workday career sites: paste the careers URL as shown in your browser, e.g.\n// 'https://astrazeneca.wd3.myworkdayjobs.com/Careers'\nconst WORKDAY_URLS = [\n];\n\nconst COMPANIES = `4flow|Abercrombie & Fitch|Aeries Technology|AHEAD|Airbus|Albertsons|Alcon|Alvarez & Marsal|AMD|Amtech Software|Aon|Applied Materials|Arctic Wolf|ARKO Corp|Arrive|AstraZeneca|Atlassian|Availity|Axiado|BAT|Bayer|Bioforum|Care ADHD|Cargill|Catalyst Brands|Celonis|Chevron|Codec|Cognite|Consilio|CrashPlan|Curriculum Associates|Cyderes|Datadog|Deepwatch|DigiKey|DSP|eBay|Emerson|Ericsson|Ferguson|Festo|Fidelity Investments|First Citizens Bank|FIS|Ford Business Solutions|Fresenius Medical Care|Google|Graphcore|Guidewire|Harvey AI|Honeywell|Imagine Learning|Innocean|Kraft Heinz|Ladera Technology|Lowe's|Lufthansa|Magnum Ice Cream Company|Merck|Microchip Technology|MKS|Morgan Stanley|Mythic AI|Natus Sensory|NatWest|Netsmart|Pegasystems|Pioneer India|Progress Software|Proximus|RakSul|Rakuten|Reltio|RI Riveron|Rolls-Royce|SAP Labs India|Saptharushi India|Saviynt|SBM Offshore|Serko|Sirva|Skillz|Smartsheet|SolarEdge Technologies|State Bank of India|Stryker|Target Corporation|Tazapay|Texas Instruments|Thales|The Standard|Thermo Fisher Scientific|Toast|Toyota Motor Corporation|Under Armour|Wayfair|WEKA|Wells Fargo|WEX|WirelessCar|Woodside Energy|ZEISS|Zimmer Biomet|ZS Associates|ABC Fitness|Acumatica|Agilent Technologies|Amgen|Aperam|Apple India|ArcelorMittal|BASF|Billtrust|BL Blupace|Blackbaud|Boston Consulting Group|Centrica|Charles Schwab|CIBC|Citizens Financial Group|Citrin Cooperman|Cohere Health|Costco Wholesale|Coupang|Covasant Technologies|DA Dai-ichi Life Group|Dark Matter|DAZN|DESRI|Deutsche B\u00f6rse|Eli Lilly and Company (India)|Entain|Evergent Technologies|Facebook India Online Services Pvt Ltd|Flutter Entertainment|Fortuna Entertainment Group|GI Outsourcing|Guidehouse|HCA Healthcare|HEINEKEN|HSBC|Hyland|Insight Global|InvoiceCloud|IQ-EQ|isolved|Itineris|JAGGAER|JLL|Johnson & Johnson|JPMorgan Chase|L'Or\u00e9al|LiveRamp|Lonza Group|LPL Financial|Marriott International|Mattel|Maximus Inc|McDonald's|Meltwater|Miamin Systems|MSD|Nasuni|Nationwide|Nemetschek Group|Netflix|Novartis|Oaktree Capital|Octave|Omnicom Group|Optimum Solutions|Otto Group|ProductSquads|Proofpoint|Protolabs|Providence Health|Reckitt|Redwood Software|Regeneron Pharmaceuticals|Sanofi|Silicon Labs|Sonatype|Sonoco|Southwest Airlines|StarRez|Stolt-Nielsen|Syneos Health|Syneriq Global|T-Mobile USA|TestingXperts|The Hartford|Theom|Tredence|Truist Financial Corporation|Truveta|UBS|Vanguard|Veramed|VIRA Insight|Voya Financial|Welspun|Western Union|Wise|Workato|Zurich Insurance Group|Altimetrik|AMS|Aramex|Arctera|Assent|AT&S|Boston Scientific|bp|Calderys|Cognyte|DAMAC Group|DeepIntent|Eaton|Edwards Lifesciences|Fastly|Fluidra|Generac|Hexadex|HMH Tech India|Intercontinental Exchange|Leidos|Liebherr|Litmos|Medtronic|METRO AG|MindZvue|Mizuho|Orbia|Orion Innovation|Rapid7|Sandvik|Schmersal|SKF|Snowflake|Sonny's Enterprises|Syensqo|Syngenta|Tenthpin|TVH India|Unipart|Vanderlande|Veradigm|Wacker|Zendesk`.split('|');\n// ===== end of settings =====\n\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};   // jobKey -> true\nstore.ats = store.ats || {};     // company -> {type, slug} or {type:'none'}\nstore.primed = store.primed || {}; // feed -> true once first fetch done (no alerts on first fetch)\n\nconst http = async (opts) => {\n  try { return await this.helpers.httpRequest({ json: true, timeout: 8000, ...opts }); }\n  catch (e) { return null; }\n};\n\nconst slugs = (name) => {\n  let b = name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')\n    .replace(/\\(.*?\\)/g, '').replace(/&/g, 'and').replace(/'/g, '').replace(/[^a-z0-9 ]/g, ' ')\n    .replace(/\\b(india|inc|corp|corporation|group|technologies|technology|pvt|ltd|online services|labs|the|company)\\b/g, ' ')\n    .replace(/\\s+/g, ' ').trim();\n  const v = [b.replace(/ /g, ''), b.replace(/ /g, '-'), b.split(' ')[0]];\n  return [...new Set(v.filter((s) => s && s.length > 1))];\n};\n\n// --- 1. Auto-detect which public job board each company uses (Greenhouse / Lever / Ashby)\n// Runs in parallel and stops early so the node stays well under n8n's 60-second limit.\nconst START = Date.now();\nconst elapsed = () => Date.now() - START;\nconst pool = async (list, size, fn) => {\n  const out = []; let i = 0;\n  await Promise.all(Array.from({ length: Math.min(size, list.length) }, async () => {\n    while (i < list.length) { const k = i++; out[k] = await fn(list[k]); }\n  }));\n  return out;\n};\nconst detectOne = async (c) => {\n  const ss = slugs(c); const first = ss[0] || '';\n  const tries = ss.flatMap((s) => [\n    http({ url: `https://boards-api.greenhouse.io/v1/boards/${s}` }).then((r) => (r && r.name && r.name.toLowerCase().includes(first.slice(0, 4)) ? { type: 'greenhouse', slug: s } : null)),\n    http({ url: `https://api.lever.co/v0/postings/${s}?mode=json&limit=1` }).then((r) => (Array.isArray(r) && r.length ? { type: 'lever', slug: s } : null)),\n    http({ url: `https://api.ashbyhq.com/posting-api/job-board/${s}` }).then((r) => (r && Array.isArray(r.jobs) ? { type: 'ashby', slug: s } : null)),\n  ]);\n  const res = await Promise.all(tries);\n  return res.find(Boolean) || { type: 'none' };\n};\nconst todo = COMPANIES.filter((c) => !store.ats[c]).slice(0, DETECT_PER_RUN);\nfor (let k = 0; k < todo.length && elapsed() < 20000; k += 5) {\n  const batch = todo.slice(k, k + 5);\n  const found = await Promise.all(batch.map(detectOne));\n  batch.forEach((c, n) => { store.ats[c] = found[n]; });\n}\n\n// --- 2. Fetch jobs from every known feed (8 at a time)\nconst jobs = []; // {feed, key, company, title, location, url}\nconst feeds = Object.entries(store.ats).filter(([, a]) => a.type !== 'none');\nawait pool(feeds, 8, async ([c, a]) => {\n  if (elapsed() > 38000) return;\n  if (a.type === 'greenhouse') {\n    const r = await http({ url: `https://boards-api.greenhouse.io/v1/boards/${a.slug}/jobs?content=true` });\n    (r?.jobs || []).forEach((j) => jobs.push({ feed: c, key: `gh:${j.id}`, company: c, title: j.title, location: j.location?.name || '', url: j.absolute_url, desc: strip(j.content) }));\n  } else if (a.type === 'lever') {\n    const r = await http({ url: `https://api.lever.co/v0/postings/${a.slug}?mode=json` });\n    (Array.isArray(r) ? r : []).forEach((j) => jobs.push({ feed: c, key: `lv:${j.id}`, company: c, title: j.text, location: `${j.categories?.location || ''} ${j.workplaceType || ''}`, url: j.hostedUrl, desc: `${j.descriptionPlain || ''} ${(j.lists || []).map((x) => strip(x.content)).join(' ')}` }));\n  } else if (a.type === 'ashby') {\n    const r = await http({ url: `https://api.ashbyhq.com/posting-api/job-board/${a.slug}` });\n    (r?.jobs || []).forEach((j) => jobs.push({ feed: c, key: `ab:${j.jobUrl}`, company: c, title: j.title, location: `${j.location || ''} ${j.isRemote ? 'Remote' : ''}`, url: j.jobUrl, desc: j.descriptionPlain || strip(j.descriptionHtml) }));\n  }\n});\nawait pool(WORKDAY_URLS, 4, async (u) => {\n  const m = u.match(/^https:\\/\\/([^.]+)\\.(wd\\d+)\\.myworkdayjobs\\.com\\/(?:[a-z]{2}-[A-Z]{2}\\/)?([^/?#]+)/);\n  if (!m || elapsed() > 38000) return;\n  const [, tenant, wd, site] = m;\n  const host = `https://${tenant}.${wd}.myworkdayjobs.com`;\n  const rs = await Promise.all(WORKDAY_SEARCHES.map((q) => http({ method: 'POST', url: `${host}/wday/cxs/${tenant}/${site}/jobs`, body: { appliedFacets: {}, limit: 20, offset: 0, searchText: q } })));\n  rs.forEach((r) => (r?.jobPostings || []).forEach((j) => jobs.push({ feed: u, key: `wd:${tenant}:${j.externalPath}`, company: tenant, title: j.title, location: j.locationsText || '', url: `${host}/${site}${j.externalPath}`, wd: `${host}/wday/cxs/${tenant}/${site}${j.externalPath}` })));\n});\n\n// --- 3. Keep only new, matching jobs (first fetch of a feed just records what's there)\nconst fresh = [];\nconst feedsThisRun = new Set(jobs.map((j) => j.feed));\nfor (const j of jobs) {\n  if (store.seen[j.key] || fresh.some((f) => f.key === j.key)) continue;\n  store.seen[j.key] = true;\n  if (!store.primed[j.feed]) continue;\n  if (!(LOC.test(j.location) || /locations/i.test(j.location))) continue;\n  let ok = ROLES.test(j.title);\n  if (!ok && !EXCLUDE.test(j.title)) {\n    if (j.wd && !j.desc && elapsed() < 46000) { const d = await http({ url: j.wd }); j.desc = strip(d?.jobPostingInfo?.jobDescription); }\n    ok = ROLES.test(j.desc || '');\n    if (ok) j.why = 'matched in description';\n  }\n  if (ok) fresh.push(j);\n}\nfeedsThisRun.forEach((f) => { store.primed[f] = true; });\n\n// --- 4. Ping Telegram\nif (fresh.length && !TELEGRAM_TOKEN.startsWith('PASTE')) {\n  const lines = fresh.map((j) => `\u2022 ${j.title} \u2014 ${j.company} (${j.location.trim()})${j.why ? ' [' + j.why + ']' : ''}\\n${j.url}`);\n  let msg = `\ud83c\udd95 ${fresh.length} new PM job${fresh.length > 1 ? 's' : ''}\\n\\n`;\n  for (const l of lines) {\n    if ((msg + l).length > 3800) {\n      await http({ method: 'POST', url: `https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage`, body: { chat_id: TELEGRAM_CHAT_ID, text: msg, disable_web_page_preview: true } });\n      msg = '';\n    }\n    msg += l + '\\n\\n';\n  }\n  if (msg) await http({ method: 'POST', url: `https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage`, body: { chat_id: TELEGRAM_CHAT_ID, text: msg, disable_web_page_preview: true } });\n}\n\nconst counts = Object.values(store.ats).reduce((a, x) => ((a[x.type] = (a[x.type] || 0) + 1), a), {});\nreturn [{ json: {\n  new_jobs: fresh.length,\n  jobs_checked: jobs.length,\n  companies_detected_so_far: Object.keys(store.ats).length + ' of ' + COMPANIES.length,\n  boards_found: counts,\n  on_public_boards: Object.entries(store.ats).filter(([, a]) => a.type !== 'none').map(([c, a]) => `${c} (${a.type})`),\n  not_found_add_manually: Object.entries(store.ats).filter(([, a]) => a.type === 'none').map(([c]) => c),\n  new: fresh.map(({ desc, wd, ...j }) => j),\n} }];\n"
   },
